# ==============================================================================
# MORROW: Environment Configuration Template
# Duplicate this file to .env and configure specific environment values.
# NEVER commit actual secrets, keys, or passwords to version control.
# ==============================================================================

# Application Environment (development | staging | production | testing)
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings.development

# Django Core Security
# Generate a secure secret key in production: `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=django-insecure-change-me-in-production-template-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_NAME=morrow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Razorpay Payment Gateway (Test Mode for development)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
RAZORPAY_CURRENCY=INR

# Email Notification Service (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@morrow.example.com
EMAIL_HOST_PASSWORD=placeholder_app_password
DEFAULT_FROM_EMAIL="MORROW Events <notifications@morrow.example.com>"

# Security & CORS (Production settings)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Static and Media Storage
STATIC_URL=/static/
MEDIA_URL=/media/

